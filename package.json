{
  "name": "wps-agent-editor",
  "version": "0.1.0",
  "description": "跨平台桌面文档编辑器 - OnlyOffice + 多 Agent 协作",
  "main": "./out/main/main.js",
  "author": "WPS Agent Editor",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:bridge": "tsx server/onlyoffice-bridge/index.ts",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "check:i18n": "tsc -p tsconfig.i18n.json && tsx scripts/check-i18n.ts",
    "git:sync": "node scripts/auto-git-sync.mjs --once",
    "git:watch": "node scripts/auto-git-sync.mjs",
    "verify:i18n-ui": "node scripts/electron-verify-language-menu.mjs",
    "verify:app-menu": "node scripts/electron-verify-app-menu.mjs",
    "verify:provider-catalog": "tsx scripts/check-provider-model-filter.ts",
    "verify:provider-settings": "node scripts/electron-verify-provider-settings.mjs",
    "verify:code-editor": "node scripts/electron-verify-code-editor.mjs",
    "verify:excel-scroll": "node scripts/electron-verify-excel-scroll-performance.mjs",
    "postinstall": "node -e \"try{require('fs').readFileSync('node_modules/electron/path.txt')}catch(e){console.log('Run: npm run install:electron')}\"",
    "install:electron": "powershell -ExecutionPolicy Bypass -File scripts/install-electron.ps1"
  },
  "dependencies": {
    "@fortune-sheet/core": "^1.0.4",
    "@fortune-sheet/react": "^1.0.4",
    "@langchain/anthropic": "^0.3.34",
    "@langchain/core": "^0.3.42",
    "@langchain/google-genai": "^0.1.12",
    "@langchain/openai": "^0.4.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@superdoc-dev/react": "^1.15.0",
    "chart.js": "^4.4.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dompurify": "^3.4.12",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "font-list": "^2.1.0",
    "iconv-lite": "^0.7.3",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "langchain": "^0.3.19",
    "lucide-react": "^0.475.0",
    "mammoth": "^1.12.0",
    "marked": "^18.0.6",
    "monaco-editor": "^0.55.1",
    "pdfjs-dist": "^5.7.284",
    "pptxviewjs": "^1.1.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "superdoc": "^1.44.0",
    "tailwind-merge": "^3.0.1",
    "tsx": "^4.19.3",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "electron@34.2.0": true
  }
}
